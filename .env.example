# Copy to `.env` (git-ignored) and adjust. Vite inlines VITE_* values into the bundle at build
# time, so they are public by design: never put secrets here (the Google *client id* is public,
# a client *secret* must not be used by the frontend at all).

# Base URL of the backend API including the /api prefix (backend: `dotnet run` -> https://localhost:7054,
# `docker compose up` -> http://localhost:8080). Use https://localhost:7054/api in development; the
# browser only accepts it after `dotnet dev-certs https --trust`.
VITE_API_URL=https://localhost:7054/api

# OAuth client id (Google Cloud Console -> Credentials -> Web client). Must be the same value the
# backend has as `Google:ClientId`, otherwise the backend rejects the ID token.
# Leave it empty to run without Google: the login screen then shows the email form only.
# The origin the app runs on (http://localhost:5173 in development) must be listed under
# "Authorized JavaScript origins" of that client in the Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
